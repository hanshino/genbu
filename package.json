{
  "name": "genbu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "node --env-file-if-exists=.env --import tsx scripts/db-changelog.ts",
    "sync:images": "node scripts/sync-equipment-images.mjs",
    "db:pull": "node scripts/db-release.mjs pull",
    "db:publish": "node scripts/db-release.mjs publish",
    "combat:vectors": "uv run --project ../tthol-combat python scripts/combat/gen_vectors.py src/lib/combat/__tests__/vectors.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@base-ui/react": "^1.9.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
