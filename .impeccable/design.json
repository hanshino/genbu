      "refersTo": "input",
      "description": "32px 高、筆線框，focus 轉朱砂餘韻。",
      "html": "<input class=\"ds-input\" placeholder=\"搜尋道具、怪物、NPC…\">",
      "css": ".ds-input{height:32px;width:280px;padding:4px 10px;border-radius:10px;border:1px solid var(--input,oklch(0.88 0.012 85));background:transparent;color:var(--foreground,oklch(0.22 0.015 260));font-size:14px;outline:none;transition:border-color .15s,box-shadow .15s;font-family:var(--font-sans-tc),\"Noto Sans TC\",system-ui,sans-serif;}.ds-input::placeholder{color:var(--muted-foreground,oklch(0.48 0.018 260));}.ds-input:focus-visible{box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.65 0.15 27)) 50%,transparent);border-color:var(--ring,oklch(0.65 0.15 27));}"
    },
    {
      "name": "Navbar",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "品牌字朱砂、目前頁用淡墨渲而非朱砂。",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-brand\" href=\"#\"><b>玄武</b><span>Genbu</span></a><a class=\"ds-nav-link\" href=\"#\">首頁</a><button class=\"ds-nav-link ds-nav-active\">資料 <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button class=\"ds-nav-link\">工具 <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><a class=\"ds-nav-link\" href=\"#\">改版紀錄</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;height:56px;padding:0 16px;border-bottom:1px solid color-mix(in oklch,var(--border,oklch(0.88 0.012 85)) 60%,transparent);background:color-mix(in oklch,var(--background,oklch(0.975 0.008 85)) 80%,transparent);backdrop-filter:blur(8px);font-family:var(--font-sans-tc),\"Noto Sans TC\",system-ui,sans-serif;}.ds-nav-brand{display:flex;align-items:baseline;gap:8px;margin-right:12px;text-decoration:none;}.ds-nav-brand b{font-family:var(--font-serif-tc),'Noto Serif TC',serif;font-size:20px;color:var(--primary,oklch(0.52 0.17 27));}.ds-nav-brand span{font-size:12px;color:var(--muted-foreground,oklch(0.48 0.018 260));}.ds-nav-link{display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 10px;border-radius:8px;border:0;background:transparent;color:var(--foreground,oklch(0.22 0.015 260));font-size:13px;font-weight:500;text-decoration:none;cursor:pointer;transition:background .15s;font-family:inherit;}.ds-nav-link:hover{background:var(--muted,oklch(0.95 0.008 85));}.ds-nav-link:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.65 0.15 27)) 50%,transparent);border-color:var(--ring,oklch(0.65 0.15 27));}.ds-nav-active{background:var(--secondary,oklch(0.935 0.012 85));}"
    },
    {
